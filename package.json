{
  "name": "modulus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MODULUS — Deterministic 120Hz 3D Engineering Racing Simulator & PWA on Cloudflare Edge",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply modulus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply modulus-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "hono": "^4.7.4",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.3",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.12",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wrangler": "^4.4.0"
  }
}
